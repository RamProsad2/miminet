# Local development settings for compose.yaml.
# `./miminet.sh up` copies this file to .env on first run and replaces every
# value marked __GENERATE__ with a random secret. Edit .env, not this file.
# Not used by prod (front/.env, back/.env, docker-compose-prod.yml).

# ---- Host -------------------------------------------------------------------
# Host port for the web UI (http://localhost:${HTTP_PORT}).
HTTP_PORT=80
# Host port for the RabbitMQ management UI, bound to 127.0.0.1 only.
RABBITMQ_MANAGEMENT_PORT=15672

# ---- App --------------------------------------------------------------------
MODE=dev
SECRET_KEY=__GENERATE__
JWT_SECRET_KEY=__GENERATE__
ACCESS_TOKEN_EXPIRES=3
REFRESH_TOKEN_EXPIRES=12
# Empty = host-only cookies, needed when the UI is opened as localhost/IP.
JWT_COOKIE_DOMAIN=
EXTERNAL_BASE_URL=/
ALLOWED_HOSTS=http://localhost

# ---- Sign-in ----------------------------------------------------------------
# Login page options: password, vk, yandex. VK/Yandex need vk_auth.json /
# client_yandex.json in front/src and an OAuth app whose redirect_uri points
# at this host, so locally only "password" works out of the box.
# The app refuses to start with "password" or DEV_ADMIN_PASSWORD unless MODE=dev.
AUTH_PROVIDERS=password
# Admin account (role 1, admin panel access) created/updated on every start.
DEV_ADMIN_EMAIL=admin@local
DEV_ADMIN_PASSWORD=admin
# The test user selenium/password (no admin rights) is also always created in dev.

# ---- PostgreSQL ---------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_DEFAULT_USER=miminet
POSTGRES_DEFAULT_PASSWORD=__GENERATE__
POSTGRES_DATABASE_NAME=miminet

# ---- RabbitMQ ---------------------------------------------------------------
RABBITMQ_DEFAULT_USER=miminet
RABBITMQ_DEFAULT_PASS=__GENERATE__
exchange_name=default_exchange
result_queue_name=common-results-queue
rpc_urls=rpc://

# Celery concurrency of the web app's result worker and of the emulation worker.
FRONT_CELERY_CONCURRENCY=4
BACK_CELERY_CONCURRENCY=2
